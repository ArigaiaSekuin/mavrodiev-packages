  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Terrain by hand</b>\n<size=70%>A terrain is made in three steps: its shape, its textures, then the objects on it. Here every step is done by hand, with the brushes of the Terrain Tools package.\n\n<b>Row 1 \xB7 Shape:</b> 1 The terrain object \xB7 2 Sculpting \xB7 3 A brush is an image\n<b>Row 2 \xB7 Texture:</b> 4 Terrain Layers \xB7 5 Painting the layers\n<b>Row 3 \xB7 Objects:</b> 6 Trees \xB7 7 Grass and details \xB7 8 Rocks\n\nEvery station has its own terrain to change, and its own camera.</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
