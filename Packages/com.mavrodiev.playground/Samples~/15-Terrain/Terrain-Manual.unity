  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Paint Texture paints a layer's weight with the brush. Where layers meet, their weights blend, and at every point the weights add up to one. The terrain keeps the weights in hidden images, the splat maps: one colour channel per layer.\n\n<b>Predict:</b> You paint the rock layer at full Brush Strength over the grass. Is any grass left there?\n\n<b>Try:</b>\n1. Select Terrain 5 \u203A Paint Texture; select the rock layer.\n2. Paint along the slope of the hill.\n3. Lower Brush Strength to 20 and paint the edge, so the two layers blend.\n\n<size=85%><color=#A8A8A8>Reference: Terrain Tools manual \u203A Paint Texture \xB7 Brush Mask Filters (Height, Slope)</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
