  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Paint Terrain holds the sculpting tools. Raise or Lower Terrain adds height under the brush (Shift lowers it); Set Height pulls the ground to one height; Smooth Height evens out bumps. Brush Size sets where, Brush Strength how much. Terrain Tools adds more: Noise, Terrace, Erosion.\n\n<b>Predict:</b> Set Height is at 3 m. You paint across a hill 6 m tall. What happens to the hill?\n\n<b>Try:</b>\n1. Select Terrain 2 \u203A Paint Terrain \u203A Set Height; Height 3.\n2. Paint across the hill.\n3. Switch to Smooth Height and soften the edges of the cut.\n\n<size=85%><color=#A8A8A8>Reference: Terrain Tools manual \u203A Paint Terrain \u203A Sculpt</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
