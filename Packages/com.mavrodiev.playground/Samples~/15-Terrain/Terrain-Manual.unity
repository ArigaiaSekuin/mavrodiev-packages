  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Paint Details scatters small plants: grass, flowers, bushes. A detail is a mesh or a grass texture. The terrain draws thousands of them, but only near the camera: beyond the Detail Distance they are not drawn. Density sets how many.\n\n<b>Predict:</b> The camera moves 100 m away from the grass. What does it see?\n\n<b>Try:</b>\n1. Select Terrain 7 \u203A Paint Details; pick Grass-Tuft.\n2. Paint a patch.\n3. Terrain Settings \u203A Detail Distance: set 20, then zoom out in the Scene view.\n\n<size=85%><color=#A8A8A8>Reference: Terrain Tools manual \u203A Paint Details \xB7 plants: LOLIPOP, CC BY 4.0 (Sketchfab)</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
