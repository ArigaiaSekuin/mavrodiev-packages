  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Terrain Layer Rules paints the Terrain Layers by rules instead of a brush. The Base Layer covers the whole terrain. Each row in Layers On Top sets a height range and a slope range, and later rows cover earlier ones. Nothing changes until Paint Layers is pressed, so after a change of shape, press it again.\n\n<b>Predict:</b> The rock layer covers slopes steeper than 30\xB0. Its minimum goes down to 15\xB0. Where does rock appear?\n\n<b>Try:</b>\n1. Select Terrain 4; in Terrain Layer Rules, open the Rock row under Layers On Top.\n2. Lower the start of Slope Range Degrees to 15.\n3. Press Paint Layers.\n\n<size=85%><color=#A8A8A8>Reference: Toolbox \u203A Terrain Layer Rules</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
