  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Terrain by rules</b>\n<size=70%>The same three steps, shape, texture and objects, set by data and rules instead of a brush. Change a setting, and the terrain is rebuilt.\n\n<b>Row 1 \xB7 Shape:</b> 1 A heightmap as the shape \xB7 2 Hills from noise\n<b>Row 2 \xB7 Texture:</b> 3 Colour by height, in the shader \xB7 4 Layers by rules\n<b>Row 3 \xB7 Objects:</b> 5 Trees and rocks by rules \xB7 6 Grass by rules\n\nTools: Terrain Tools (Unity) \xB7 Hill Terrain Generator, Terrain Layer Rules and Terrain Tree And Grass Rules (toolbox).</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
