  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A procedural shape starts from data instead of the hand: a heightmap from a generator, real elevation data of a place, or a stamp from the asset library. The Terrain Toolbox imports one as a whole new terrain; Terrain Height sets how tall white is.\n\n<b>Predict:</b> Terrain Height goes from 15 m to 30 m. What changes, and what stays the same?\n\n<b>Try:</b>\n1. Select Terrain 1 \u203A Terrain Settings.\n2. Set Terrain Height to 30.\n3. Window \u203A Terrain \u203A Terrain Toolbox \u203A Create New Terrain: find Import Heightmap.\n\n<size=85%><color=#A8A8A8>Reference: Terrain Tools manual \u203A Terrain Toolbox \u203A Import Heightmap</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
