  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Hill Terrain Generator writes the whole heightmap from noise: random values that change smoothly. Base Frequency sets how close the hills are; Octaves add smaller bumps on top; the Height Curve reshapes the result. The same Seed always gives the same hills.\n\n<b>Predict:</b> Base Frequency goes from 0.05 to 0.15. Do the hills get wider or narrower?\n\n<b>Try:</b>\n1. Select Terrain 2; in Hill Terrain Generator, open its Profile.\n2. Set Base Frequency to 0.15.\n3. On Hill Terrain Generator, click the three dots \u203A Generate.\n\n<size=85%><color=#A8A8A8>Reference: Toolbox \u203A Hill Terrain Generator \xB7 Terrain Tools manual \u203A Noise (the same idea as a brush)</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
