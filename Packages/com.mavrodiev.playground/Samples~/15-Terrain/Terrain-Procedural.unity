  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A terrain's material can colour it with no layers and no painting. The Height Bands shader picks a colour from each point's height and slope, so the colours follow the shape. The Mono shader shows the bare shape in one colour. Both need Draw Instanced off.\n\n<b>Predict:</b> The hills are generated again with a new Seed. Do the colours need repainting?\n\n<b>Try:</b>\n1. Select the material M_Terrain_Height-Bands.\n2. Set Mid to High to 4 and Steep from to 25.\n3. Change the Seed in Terrain 3's profile, then Generate.\n\n<size=85%><color=#A8A8A8>Reference: Toolbox \u203A Shaders \u203A Terrain (Mono, Height-Bands)</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
