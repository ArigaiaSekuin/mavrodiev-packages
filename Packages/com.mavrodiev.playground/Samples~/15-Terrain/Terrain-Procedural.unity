  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Terrain Tree And Grass Rules places trees and rocks by rules: a height range, a slope range, a chance in percent, and a minimum distance between copies. Place Trees replaces them all. The result is ordinary terrain trees, so Paint Trees can still edit them, until the next press.\n\n<b>Predict:</b> The oaks' slope range is 0 to 20\xB0. What happens on the steep sides of the hills?\n\n<b>Try:</b>\n1. Select Terrain 5; in Terrain Tree And Grass Rules, open the Oak row under Trees And Rocks.\n2. Raise Slope Range Degrees to 0\u201340.\n3. Press Place Trees.\n\n<size=85%><color=#A8A8A8>Reference: Toolbox \u203A Terrain Tree And Grass Rules \xB7 trees: LOLIPOP, CC BY 4.0 (Sketchfab) \xB7 rocks: rubberduck, CC0</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
