  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A leaf or a blade of grass is too small to model one by one. A plant is built from cards: flat quads with a photo of leaves, where the transparent parts are cut away (Alpha Clipping). Seen from a distance, many crossing cards read as a volume.\n\n<b>Predict:</b> How many triangles does the bush have: tens, hundreds or thousands?\n\n<b>Try:</b>\n1. Set Draw Mode to Shaded Wireframe.\n2. Orbit around the bush and the grass, from the side and from above.\n3. Select the bush's child Bush-Medium_LOD0; click the mesh in its Mesh Filter: read its triangle count.\n\n<size=85%><color=#A8A8A8>Reference: 2 \xB7 Materials \u203A Lit-Shader (Alpha Clipping) \xB7 plants: LOLIPOP, CC BY 4.0 (Sketchfab)</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
