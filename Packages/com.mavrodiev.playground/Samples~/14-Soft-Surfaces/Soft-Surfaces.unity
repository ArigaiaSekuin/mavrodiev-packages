  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A Terrain is a flat grid of points lifted by a greyscale image, the heightmap: black is the lowest point, white the highest. Each point moves only up or down, so a terrain cannot make overhangs, caves or arches. Those are meshes placed on top of it.\n\n<b>Predict:</b> Find the brightest spot on the image lying next to the terrain. Where is it on the terrain?\n\n<b>Try:</b>\n1. Look through the station camera, from above.\n2. Match the light and dark areas of the image to the terrain.\n3. Select the terrain \u203A Terrain Settings: read the Heightmap Resolution, the number of points on each side.\n\n<size=85%><color=#A8A8A8>Reference: Unity Manual \u203A Terrain \u203A Working with Heightmaps</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
