  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A hard surface is made of flat faces that meet at sharp edges: walls, boxes, machines. A soft surface curves everywhere: ground, rocks, plants, bodies. Both are meshes of triangles. A soft surface needs many more of them, and its normals are smoothed, so the light shows no edges.\n\n<b>Predict:</b> The cube and the rock are about the same size. How many more triangles does the rock have: twice as many, ten times, or a hundred times?\n\n<b>Try:</b>\n1. In the Scene view, set Draw Mode to Shaded Wireframe.\n2. Compare the triangles on the cube and on the rock.\n3. Click the mesh in each Mesh Filter: the preview at the bottom of the Inspector gives its triangle count.\n\n<size=85%><color=#A8A8A8>Reference: 1 \xB7 Meshes \u203A Mesh-Shape (vertices, edges, faces) \xB7 Mesh-Surface (smooth and hard edges)</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
